# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=isg_brain
POSTGRES_USER=isg
POSTGRES_PASSWORD=localdev

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Inference (swap provider here)
INFERENCE_PROVIDER=claude
ADMIN_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=whisper
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_COST_PER_MINUTE=0.006

# API Server
API_PORT=3100
INTERNAL_API_BASE_URL=http://127.0.0.1:3100
BRAIN_API_URL=http://localhost:3100
TZ=America/Los_Angeles

# Google OAuth (shared by Gmail, Calendar, and Drive)
GOOGLE_CREDENTIALS_PATH=google-credentials.json
GOOGLE_TOKEN_PATH=google-token.json
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_TOKEN_SCOPE=
GOOGLE_TOKEN_TYPE=Bearer
GOOGLE_TOKEN_EXPIRY=

# Gmail and scheduler alerts
GMAIL_AUTO_SEND=false
GMAIL_FROM_ALIAS=ISG Second Brain
BROKER_EMAIL=
BROKER_ALERT_EMAIL=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=America/Los_Angeles
CALENDAR_APPOINTMENT_DURATION_MINUTES=60

# Google Drive
GOOGLE_DRIVE_ROOT_FOLDER=ISG-Brain

# Monday.com
MONDAY_API_TOKEN=
MONDAY_DONE_STATUSES=done,closed,complete,completed
MONDAY_LISTINGS_TEMPLATE_GROUP_ID=TODO_add_when_template_group_exists

# Live property sync
REALESTATETOOL_URL=

# Optional branded PDF metadata
ISG_BROKER_NAME=
ISG_BROKER_EMAIL=
ISG_BROKER_PHONE=
